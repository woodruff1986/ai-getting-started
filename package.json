{
  "name": "ai-getting-started",
  "version": "1.0.0",
  "private": true,
  "description": "Desk Cursor — interface web locale (Next.js) pour workflows Cursor",
  "author": "Local",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "cross-env ELECTRON_STANDALONE=1 next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "electron:dev": "cross-env ELECTRON_STANDALONE=1 npm run build:standalone && electron .",
    "dist:win": "npm run build:standalone && electron-builder --win --x64",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate-embeddings-pinecone": "node src/scripts/indexBlogs.mjs",
    "generate-embeddings-supabase": "node src/scripts/indexBlogPGVector.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@arcjet/next": "^1.0.0-alpha.13",
    "@clerk/nextjs": "^5.1.4",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^1.7.15",
    "@pinecone-database/pinecone": "^2.2.2",
    "@supabase/supabase-js": "^2.25.0",
    "@tailwindcss/forms": "^0.5.7",
    "ai": "^2.1.3",
    "autoprefixer": "10.4.19",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "hnswlib-node": "^1.4.2",
    "langchain": "^0.0.100",
    "lucide-react": "^0.577.0",
    "next": "14.2.3",
    "openai": "^6.32.0",
    "pdf-parse": "^1.1.1",
    "postcss": "8.4.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-github-btn": "^1.4.0",
    "replicate": "^0.9.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.2.14",
    "@types/node": "20.14.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "8.56.0",
    "eslint-config-next": "14.2.3",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5"
  },
  "build": {
    "appId": "com.aigettingstarted.deskcursor",
    "productName": "Desk Cursor",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "npmRebuild": false,
    "files": ["electron/main.cjs", "package.json"],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      },
      {
        "from": "electron/INSTALL_FR.txt",
        "to": "INSTALL_FR.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["fr_FR", "en_US"],
      "language": "1040",
      "shortcutName": "Desk Cursor"
    }
  }
}
